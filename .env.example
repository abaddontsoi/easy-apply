# Railway sets these three. The build and start commands fetch the other values from Infisical.
INFISICAL_ID=
INFISICAL_TOKEN=
INFISICAL_ENV=

# Names stored in Infisical. Leave the values empty here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
APIFY_TOKEN=
